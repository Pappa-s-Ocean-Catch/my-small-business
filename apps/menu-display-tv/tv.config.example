# Example configuration for TV deployment
# Copy this file to tv.config or .env to set your local settings.

# Single TV IP address
# TV_IP=192.168.1.100

# Multiple TV IP addresses (space separated)
# TV_IPS=192.168.1.100 192.168.1.101 192.168.1.102

# Custom ADB Port (default: 5555)
# TV_PORT=5555
