{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pappas POS",
  "version": "0.1.0",
  "identifier": "com.pappas.pos.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Pappas POS", "width": 1280, "height": 800, "minWidth": 1024, "minHeight": 640, "resizable": true }]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../../pappas-order-management/assets/android-chrome-512x512.png"]
  }
}
