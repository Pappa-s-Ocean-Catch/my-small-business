{
  "name": "pappas-order-management",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "prestart": "node scripts/generate-sound-assets.js",
    "preandroid": "node scripts/generate-sound-assets.js",
    "preandroid:direct": "node scripts/generate-sound-assets.js",
    "preios": "node scripts/generate-sound-assets.js",
    "preweb": "node scripts/generate-sound-assets.js",
    "start": "expo start",
    "android": "expo start --android --device",
    "android:tablet": "ANDROID_SERIAL=tablet:5554 expo run:android",
    "android:phone": "ANDROID_SERIAL=emulator-5554 expo run:android",
    "android:start:direct": "ANDROID_SERIAL=emulator-5554 expo start --dev-client --android",
    "ios": "expo run:ios",
    "ios:ipad": "expo run:ios --device \"iPad Pro 13-inch (M5)\"",
    "ios:start:ipad": "expo start --dev-client --ios",
    "web": "expo start --web",
    "generate-assets": "node scripts/generate-assets.js",
    "ios:tablet": "expo start --ios --device",
    "build:android:apk": "expo prebuild --platform android && cd android && ./gradlew assembleRelease",
    "build:release:android": "dotenv -e release.env -- sh -c 'expo prebuild --platform android && cd android && ./gradlew assembleRelease'",
    "build:release:ios": "dotenv -e release.env -- expo run:ios --configuration Release",
    "release:android:production": "dotenv -e release.env -- node scripts/run-with-build-metadata.mjs eas build --platform android --profile production --local --output app-release.apk",
    "update:android:production": "dotenv -e release.env -- node scripts/run-with-build-metadata.mjs eas update --channel production --environment production --platform android",
    "test:unit": "rm -rf dist-test && tsc -p tsconfig.test.json && node --test dist-test/apps/pappas-order-management/test/**/*.test.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "^6.1.2",
    "@my-small-business/app-memory": "workspace:*",
    "@my-small-business/caller-id-listener": "workspace:*",
    "@my-small-business/marketplace": "workspace:*",
    "@my-small-business/native-raw-tcp-printer": "workspace:*",
    "@my-small-business/types": "workspace:*",
    "@preeternal/react-native-cookie-manager": "^6.4.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/drawer": "^7.9.8",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-query": "^5.101.2",
    "expo": "~54.0.0",
    "expo-av": "~16.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "^6.0.20",
    "expo-document-picker": "^14.0.8",
    "expo-file-system": "^19.0.21",
    "expo-keep-awake": "^55.0.4",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-modules-core": "~3.0.29",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.21",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "^6.0.9",
    "expo-updates": "~29.0.19",
    "newrelic-react-native-agent": "^1.8.8",
    "pako": "^3.0.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-esc-pos-printer": "^4.5.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "~4.1.6",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-tcp-socket": "^6.4.1",
    "react-native-vector-icons": "^10.3.0",
    "react-native-view-shot": "^4.0.3",
    "reanimated-color-picker": "^5.1.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "dotenv-cli": "^11.0.0",
    "sharp": "^0.34.5",
    "typescript": "^5.3.3"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@react-navigation/native"
      ]
    }
  }
}