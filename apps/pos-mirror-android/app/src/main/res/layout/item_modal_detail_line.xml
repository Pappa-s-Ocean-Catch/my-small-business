<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_order_item"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Quantity -->
    <TextView
        android:id="@+id/tvModalItemQty"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="1×"
        android:textColor="@color/brand_primary"
        android:textSize="22sp" />

    <!-- Name & Addons Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvModalItemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="Flake (l)"
            android:textColor="@color/brand_text"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/layoutAddons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

    </LinearLayout>

    <!-- Subtotal -->
    <TextView
        android:id="@+id/tvModalItemSubtotal"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:gravity="end"
        android:text="$10.00"
        android:textColor="@color/brand_text"
        android:textSize="19sp" />

</LinearLayout>
