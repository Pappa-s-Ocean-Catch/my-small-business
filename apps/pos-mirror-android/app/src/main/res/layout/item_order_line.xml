<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_order_item"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- QTY -->
    <TextView
        android:id="@+id/tvQuantity"
        android:layout_width="54dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="1×"
        android:textColor="@color/brand_primary"
        android:textSize="22sp" />

    <!-- ITEM NAME & BADGE -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvItemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:text="Grilled Fish &amp; Chips"
                android:textColor="@color/brand_text"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvCustomizedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_live"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="CUSTOMIZED"
                android:textColor="@color/brand_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- EACH -->
    <LinearLayout
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EACH"
            android:textColor="@color/brand_muted_text"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvUnitPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="$15.00"
            android:textColor="@color/brand_muted_text"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- TOTAL -->
    <LinearLayout
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TOTAL"
            android:textColor="@color/brand_muted_text"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvLineTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="$15.00"
            android:textColor="@color/brand_text"
            android:textSize="19sp" />
    </LinearLayout>

</LinearLayout>
