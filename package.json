{
  "name": "my-small-business",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "stripe": "stripe listen --forward-to https://localhost:3000/api/webhooks/stripe",
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "build:agent": "pnpm --filter web build:agent",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "mobile:dev": "pnpm --filter pappas-order-management start",
    "mobile:ios": "pnpm --filter pappas-order-management ios",
    "mobile:ios:ipad": "pnpm --filter pappas-order-management ios:ipad",
    "mobile:ios:start:ipad": "pnpm --filter pappas-order-management ios:start:ipad",
    "mobile:android": "pnpm --filter pappas-order-management android",
    "mobile:android:direct": "pnpm --filter pappas-order-management android:direct",
    "mobile:android:start:direct": "pnpm --filter pappas-order-management android:start:direct",
    "mobile:ios:tablet": "pnpm --filter pappas-order-management ios:tablet",
    "mobile:android:tablet": "pnpm --filter pappas-order-management android:tablet",
    "escpos-sim": "pnpm --dir tools/escpos-printer-server start",
    "escpos-sim:dev": "pnpm --dir tools/escpos-printer-server dev",
    "app:prebuild": "pnpm --filter pappas-order-management exec expo prebuild",
    "app:prebuild:clean": "pnpm --filter pappas-order-management exec expo prebuild --clean",
    "app:run:android": "pnpm --filter pappas-order-management exec expo run:android",
    "app:run:ios": "pnpm --filter pappas-order-management exec expo run:ios",
    "app:dev-client": "pnpm --filter pappas-order-management exec expo start --dev-client",
    "ocean-catch:dev": "pnpm --filter pappas-ocean-catch start",
    "ocean-catch:ios": "pnpm --filter pappas-ocean-catch ios",
    "ocean-catch:android": "pnpm --filter pappas-ocean-catch android",
    "ocean-catch:ios:tablet": "pnpm --filter pappas-ocean-catch ios:tablet",
    "ocean-catch:android:tablet": "pnpm --filter pappas-ocean-catch android:tablet",
    "ocean-catch:prebuild": "pnpm --filter pappas-ocean-catch exec expo prebuild",
    "ocean-catch:prebuild:clean": "pnpm --filter pappas-ocean-catch exec expo prebuild --clean",
    "ocean-catch:run:android": "pnpm --filter pappas-ocean-catch exec expo run:android",
    "ocean-catch:run:ios": "pnpm --filter pappas-ocean-catch exec expo run:ios",
    "ocean-catch:dev-client": "pnpm --filter pappas-ocean-catch exec expo start --dev-client"
  },
  "devDependencies": {
    "pnpm": "^9.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.90.1",
    "dotenv": "^17.2.3"
  }
}
